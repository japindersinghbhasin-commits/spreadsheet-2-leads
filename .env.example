# ==============================================================================
# GMAIL SMTP CREDENTIALS (MULTI-INBOX ROTATION SUPPORTED)
# ==============================================================================
# NOTE: Do NOT use normal Gmail passwords. Use Google 'App Passwords'.
# To generate: Go to Google Account -> Security -> 2-Step Verification -> App Passwords.

# Primary Account
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Additional Inboxes (Optional: The engine will automatically rotate round-robin across all of them)
# GMAIL_ADDRESS_2=second_email@gmail.com
# GMAIL_APP_PASSWORD_2=yyyy yyyy yyyy yyyy
# GMAIL_ADDRESS_3=third_email@gmail.com
# GMAIL_APP_PASSWORD_3=zzzz zzzz zzzz zzzz

# Deliverability Pacing Delay in seconds (Randomized between DELAY_MIN and DELAY_MAX)
DELAY_MIN=40
DELAY_MAX=80
