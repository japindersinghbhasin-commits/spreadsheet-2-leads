# Gmail SMTP Credentials
# NOTE: Do NOT use your normal Gmail password. Use a Google 'App Password'.
# To generate one: Go to your Google Account -> Security -> 2-Step Verification -> App Passwords.

GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Delay between emails in seconds (recommended 30-60 for cold outreach safety)
DELAY_MIN=30
DELAY_MAX=60
